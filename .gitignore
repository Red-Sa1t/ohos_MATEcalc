# Upstream mate-calc checkout (reference only, see README)
/upstream/
# Agent skills provided for the migration work
/skills/

# Third-party sources and intermediate build trees (third_party/build-mp.sh recreates them)
/third_party/src/
/third_party/build/
/third_party/tmp/
/third_party/ndk
