# Keep the prebuilt static libraries, drop libtool/pkg-config metadata with absolute paths
/third_party/prebuilt/*/lib/*.la
/third_party/prebuilt/*/lib/pkgconfig/

# Host test build output
/MateCalc/entry/src/main/cpp/tests/build/

# Python
__pycache__/
/third_party/*.tmp
/third_party/prebuilt/*/share/
